{
  "manifest_version": 3,
  "name": "PayloadForge",
  "version": "1.3.4",
  "description": "Offline API payload tools in your browser.",
  "icons": {
    "16": "icons/payloadforge-16.png",
    "32": "icons/payloadforge-32.png",
    "48": "icons/payloadforge-48.png",
    "128": "icons/payloadforge-128.png"
  },
  "action": {
    "default_title": "PayloadForge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
