{
  "manifest_version": 3,
  "name": "PayloadForge",
  "version": "1.3.0",
  "description": "Offline API payload tools in your browser.",
  "action": {
    "default_title": "PayloadForge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
