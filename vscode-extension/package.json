{
  "name": "payloadforge-vscode",
  "displayName": "PayloadForge",
  "description": "Offline tools to format, minify, redact, encode, and generate TypeScript from API payloads in Visual Studio Code.",
  "version": "1.3.5",
  "publisher": "payloadforge",
  "icon": "media/payloadforge.png",
  "license": "MIT",
  "keywords": [
    "json",
    "api",
    "payload",
    "formatter",
    "base64",
    "typescript",
    "secrets",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CarlosArman/payload-forge.git"
  },
  "homepage": "https://github.com/CarlosArman/payload-forge#readme",
  "bugs": {
    "url": "https://github.com/CarlosArman/payload-forge/issues"
  },
  "markdown": "markdown",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "payloadforge",
          "title": "PayloadForge",
          "icon": "media/payloadforge.svg"
        }
      ]
    },
    "views": {
      "payloadforge": [
        {
          "id": "payloadforge.welcome",
          "name": "Toolkit"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "payloadforge.welcome",
        "contents": "Herramientas locales para trabajar con payloads de API.\n\n[$(rocket) Abrir PayloadForge Toolkit](command:payloadforge.open)\n\n[$(settings-gear) Abrir preferencias](command:payloadforge.preferences)",
        "when": "true"
      }
    ],
    "commands": [
      {
        "command": "payloadforge.open",
        "title": "PayloadForge: Open Toolkit"
      },
      {
        "command": "payloadforge.preferences",
        "title": "PayloadForge: Open Preferences"
      },
      {
        "command": "payloadforge.formatJson",
        "title": "PayloadForge: Format JSON Selection"
      },
      {
        "command": "payloadforge.minifyJson",
        "title": "PayloadForge: Minify JSON Selection"
      },
      {
        "command": "payloadforge.encodeBase64",
        "title": "PayloadForge: Encode Selection as Base64"
      },
      {
        "command": "payloadforge.redactSecrets",
        "title": "PayloadForge: Redact Secrets in Selection"
      },
      {
        "command": "payloadforge.jsonToTypeScript",
        "title": "PayloadForge: Generate TypeScript from JSON Selection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "payloadforge.formatJson",
          "group": "payloadforge@1",
          "when": "editorHasSelection"
        },
        {
          "command": "payloadforge.minifyJson",
          "group": "payloadforge@2",
          "when": "editorHasSelection"
        },
        {
          "command": "payloadforge.redactSecrets",
          "group": "payloadforge@3",
          "when": "editorHasSelection"
        },
        {
          "command": "payloadforge.jsonToTypeScript",
          "group": "payloadforge@4",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "sync:core": "node ../scripts/sync-core.mjs",
    "check": "node --check src/extension.js",
    "prepackage": "npm run sync:core",
    "package": "npx @vscode/vsce package --out ../extensions/payloadforge-vscode.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
